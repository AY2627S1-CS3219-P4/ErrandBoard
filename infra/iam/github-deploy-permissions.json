{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LoginToEcr",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PushFiveApplicationImages",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:CompleteLayerUpload",
        "ecr:DescribeImages",
        "ecr:InitiateLayerUpload",
        "ecr:PutImage",
        "ecr:UploadLayerPart"
      ],
      "Resource": [
        "arn:aws:ecr:ap-southeast-1:614099836367:repository/ay2627-cs3219-p4/errandboard/user-service",
        "arn:aws:ecr:ap-southeast-1:614099836367:repository/ay2627-cs3219-p4/errandboard/supplier-service",
        "arn:aws:ecr:ap-southeast-1:614099836367:repository/ay2627-cs3219-p4/errandboard/order-service",
        "arn:aws:ecr:ap-southeast-1:614099836367:repository/ay2627-cs3219-p4/errandboard/credit-service",
        "arn:aws:ecr:ap-southeast-1:614099836367:repository/ay2627-cs3219-p4/errandboard/frontend"
      ]
    },
    {
      "Sid": "InspectCurrentTaskDefinitions",
      "Effect": "Allow",
      "Action": "ecs:DescribeTaskDefinition",
      "Resource": "*"
    },
    {
      "Sid": "InspectAndUpdateFiveServices",
      "Effect": "Allow",
      "Action": ["ecs:DescribeServices", "ecs:UpdateService"],
      "Resource": [
        "arn:aws:ecs:ap-southeast-1:614099836367:service/ErrandBoard/user-service",
        "arn:aws:ecs:ap-southeast-1:614099836367:service/ErrandBoard/supplier-service",
        "arn:aws:ecs:ap-southeast-1:614099836367:service/ErrandBoard/order-service",
        "arn:aws:ecs:ap-southeast-1:614099836367:service/ErrandBoard/credit-service",
        "arn:aws:ecs:ap-southeast-1:614099836367:service/ErrandBoard/frontend"
      ]
    },
    {
      "Sid": "RegisterFiveTaskFamilies",
      "Effect": "Allow",
      "Action": "ecs:RegisterTaskDefinition",
      "Resource": [
        "arn:aws:ecs:ap-southeast-1:614099836367:task-definition/user-service:*",
        "arn:aws:ecs:ap-southeast-1:614099836367:task-definition/supplier-service:*",
        "arn:aws:ecs:ap-southeast-1:614099836367:task-definition/order-service:*",
        "arn:aws:ecs:ap-southeast-1:614099836367:task-definition/credit-service:*",
        "arn:aws:ecs:ap-southeast-1:614099836367:task-definition/frontend:*"
      ]
    },
    {
      "Sid": "PassExistingEcsExecutionRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::614099836367:role/ecsTaskExecutionRole",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    }
  ]
}
