# ─────────────────────────────────────────────────────────────
# ErrandBoard · Environment configuration (EXAMPLE)
# ─────────────────────────────────────────────────────────────
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# `.env` is git-ignored — NEVER commit real secrets.
# Any variable read by any service MUST appear here with a safe
# placeholder so teammates know what to set.
#
# This is just an example; you can add more variables as needed.
# ─────────────────────────────────────────────────────────────

# MongoDB Credentials
MONGO_ROOT_PASSWORD=
MONGO_USER_SERVICE_PASSWORD=
MONGO_SUPPLIER_SERVICE_PASSWORD=
MONGO_ORDER_SERVICE_PASSWORD=
MONGO_CREDIT_SERVICE_PASSWORD=
MONGO_REPLICA_SET_KEY=
MONGO_REPLICA_SET_HOST=mongodb:27017
ORDER_CREDIT_API_KEY=
CREDIT_INTERNAL_API_KEY=
JWT_SECRET=

# Backend endpoints supplied per environment (Compose or ECS task definitions).
REDIS_URL=
RABBITMQ_URL=
FRONTEND_ORIGIN=

# Cognito email confirmation. Keep public registration closed during the pilot.
AWS_REGION=ap-southeast-1
EMAIL_VERIFICATION_PROVIDER=cognito
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_APP_CLIENT_SECRET=
COGNITO_CONFIRMATION_QUEUE_URL=
COGNITO_CONFIRMATION_WORKER_ENABLED=false
REGISTRATION_ENABLED=false
