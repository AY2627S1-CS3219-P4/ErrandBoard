{
  "name": "@errandboard/notification-service",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "typecheck:tests": "tsc --project tsconfig.test.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "vapid:generate": "tsx src/scripts/generate-vapid-keys.ts",
    "dev:send-test-event": "tsx src/scripts/send-test-event.ts"
  },
  "dependencies": {
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "mongoose": "^9.0.0",
    "redis": "^5.12.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
